# MTSCOS 登录系统环境配置文件
# 请根据实际环境修改以下配置

# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mtscos_login
DB_USER=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4
DB_TIMEZONE=+08:00

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 密码安全配置
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=6
PASSWORD_MAX_LENGTH=128

# 登录安全配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15
LOCKOUT_DURATION=30
SESSION_TIMEOUT=3600

# 限流配置
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# CORS配置
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# 第三方登录配置
# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# 微信登录
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_CALLBACK_URL=http://localhost:3001/api/auth/wechat/callback

# QQ登录
QQ_APP_ID=your_qq_app_id
QQ_APP_KEY=your_qq_app_key
QQ_CALLBACK_URL=http://localhost:3001/api/auth/qq/callback

# 支付宝登录
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_CALLBACK_URL=http://localhost:3001/api/auth/alipay/callback

# 邮件配置（用于密码重置等）
# 可选：SMTP_PROVIDER=gmail / outlook / qq / 163 / aliyun / smtp
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SMTP_FROM=MTSCOS <noreply@mtscos.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# 若使用 QQ / 163 / 阿里云等邮箱，直接把 SMTP_PROVIDER 与对应 SMTP_HOST/PORT 调整即可。

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# 文件上传配置
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# 安全配置
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
TRUST_PROXY=false

# 开发配置
DEBUG_MODE=false
MOCK_OAUTH=false
SKIP_EMAIL_VERIFICATION=false

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# API配置
API_VERSION=v1
API_PREFIX=/api
DOCS_ENABLED=true

# 数据库连接池配置
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis连接池配置
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20
REDIS_POOL_ACQUIRE=30000
REDIS_POOL_IDLE=10000

# 会话配置
SESSION_SECRET=your_session_secret_key_here
SESSION_NAME=mtscos_session
SESSION_ROLLING=true
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false

# 验证码配置
CAPTCHA_EXPIRES=300
CAPTCHA_LENGTH=6
CAPTCHA_MATH_ENABLED=true
CAPTCHA_SLIDE_ENABLED=false

# 双因素认证配置
TFA_ENABLED=false
TFA_ISSUER=MTSCOS
TFA_WINDOW=1

# 审计日志配置
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_LOG_FILE=logs/audit.log

# =====================================================================
# 【杨安 AI · Flask应用】安全环境变量模板 v1.0
# 经验 1149526：本文件仅保留占位符 __CHANGE_ME__，绝对禁止写入真实密钥/口令。
# 真实密钥必须通过系统环境变量或 .env.local（已加入 .gitignore）注入。
# ProductionConfig 缺失下面任何 SECURE_* 项必须 exit(2)，禁止 fallback 到开发默认值。
# 配置对齐：YANG_PERMISSION_OPTIMIZATION_JSON 13开关 × SA VIIKEY 7要素 × URL.create 结构化DB连接
# =====================================================================

# --- Flask 核心（必填 · SECURE组 --- 生产缺失→exit 2）
FLASK_ENV=__CHANGE_ME__                   # [dev|staging|production]  开发=development, 现网=production
SECRET_KEY=__CHANGE_ME__                  # 长度≥64 随机字符；生产环境必须每日轮转+24h overlap 宽限期
SESSION_COOKIE_NAME=__CHANGE_ME__         # 非默认session 增加猜测难度
SESSION_COOKIE_SAMESITE=Lax               # 建议 Lax；SA登录域建议 Strict
CSRF_SECRET=__CHANGE_ME__                 # CSRF签名种子 与SECRET_KEY不同

# --- 主数据库 SQLite（SQLite版，生产可切MySQL）
# DB URL 必须用 sqlalchemy.engine.URL.create(...) 结构化构造，禁止 f-string 拼接
# URL.create(drivername='sqlite+pysqlite', database='/abs/path/app.db', query={'journal_mode':'WAL'})
MAIN_DB_DATABASE=__CHANGE_ME__            # 主库绝对路径（由 core.db_path.get_db_path 运行时解析）
MAIN_DB_JOURNAL_MODE=WAL
MAIN_DB_SYNCHRONOUS=NORMAL
MAIN_DB_FOREIGN_KEYS=ON
MAIN_DB_BUSY_TIMEOUT_MS=30000
# 【MySQL切换时使用 · 占位符】禁止写真实口令到本文件
# MYSQL_USERNAME=__CHANGE_ME__
# MYSQL_PASSWORD=__CHANGE_ME__
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=mtscos_main
# MYSQL_SSL_CA=__CHANGE_ME__                 # ssl_ca路径；缺失时禁止启用SSL→退回127.0.0.1+IP白名单

# --- 杨安AI 13安全开关覆盖（可选 · 默认读取mt_security_switch_config）
# 环境变量优先级 > DB；0=关 1=开
SEC_HSTS=0
SEC_CSP_REPORT_ONLY=0                     # 先Report-Only观察14天→后启用强制
SEC_XFO_DENY=0                            # SAMEORIGIN 升级 DENY (需SA VIIKEY)
SEC_XXSS=1
SEC_REFERRER=0
SEC_XCONTENTTYPE=1
SEC_CSRF_ROTATE=1
SEC_RATE_LIMIT=1
SEC_LOGIN_PROGRESSIVE_LOCK=1
SEC_COOKIE_SAMESITE_SECURE=1
SEC_PRODUCTION_FAIL_FAST=1                # 生产SECURE缺失→exit 2（经验1149526必守）
SEC_WEAK_CONSTRAINT_WORD_ZERO=1
SEC_SA_VIKEY_HEARTBEAT_SEC=30

# --- SA 超级管理员 VIIKEY 硬件信任根 （仅SA使用，禁止普通用户填充）
# （实际 VIIKEY PID:VID 不写在环境变量中，必须通过桌面端 USB libusb 或 macOS IOKit 实时读取）
SA_ONLY_ALLOWED_USERNAME=wuchenghao15
# SA_VIKEY_VIDPID=__CHANGE_ME__   （⚠️ 绝对禁止写入仓库；仅运行时读取 USB 硬件）
# SA_SZU100_USB_UUID=__CHANGE_ME__（⚠️ SZU100专用U盘UUID，同样不能进仓库）

# --- 密码与密钥治理（对齐 NIST SP 800-63B）
PASSWORD_MIN_LENGTH=14
PASSWORD_REQUIRE_UPPER=1
PASSWORD_REQUIRE_LOWER=1
PASSWORD_REQUIRE_DIGIT=1
PASSWORD_REQUIRE_SYMBOL=1
PASSWORD_HIBP_CHECK=1                     # HaveIBeenPwned k-anonymity 比对 1=开
PASSWORD_DEFAULT_ALGO=argon2id            # argon2id | pbkdf2_sha256 | bcrypt
ARGON2ID_MEMORY_KIB=65536
ARGON2ID_TIME_COST=3
ARGON2ID_PARALLELISM=4
BCRYPT_ROUNDS=13
PBKDF2_ITERATIONS=310000

# --- JWT & Token（对齐 经验1149526：短exp + refresh轮换）
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAY=7
JWT_ISSUER=mtscos.ai.local
JWT_AUDIENCE=mtscos.frontend
JWT_ROTATE_ON_REFRESH=1                    # 每次 refresh 都颁发新 refresh（防replay）
# JWT_PRIVATE_KEY_PEM=__CHANGE_ME__        # PEM私钥；生产只通过 KMS / macOS Keychain 读取，禁止进仓库

# --- 反黑客速率 & 登录渐进锁
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=40
LOGIN_FAIL_IP_PER_5MIN=5
LOGIN_FAIL_USER_PER_30MIN=3
LOGIN_LOCK_STEP_SEC=30,60,300,1800       # 30s/60s/5m/30m 渐进
AUTH_BYPASS_DEBUG=0                        # 必须=0，禁止任何 auth 绕过后门

# --- CSP 报告接收（杨安AI security_bp /api/security/csp-report）
CSP_REPORT_COLLECT_DAYS=14
CSP_REPORT_TO_ENDPOINT=csp-endpoint
CSP_UPGRADE_TO_BLOCK_AFTER_DAY=14         # ReportOnly → 阻断模式的阈值观察天数

# --- 备份 & 加密（经验1149526：AES-256-GCM + 异地2份隔离）
BACKUP_AES_KEY=__CHANGE_ME__              # ⚠️ 绝对禁止进仓库；生产通过SA密钥管理系统读取
BACKUP_RETENTION_SHORT_DAY=7
BACKUP_RETENTION_LONG_DAY=30
BACKUP_REMOTE_DIR=__CHANGE_ME__           # OneDrive / S3 隔离路径；未配置=仅本地备份
# BACKUP_LOCAL_DIR=__CHANGE_ME__

# --- 可信代理 & IP白名单（反向代理部署时填写；空=跳过）
TRUSTED_PROXY_CIDR=
IP_WHITELIST_ADMIN=                        # SA页IP白名单，CIDR逗号分隔；空=不限制
IP_WHITELIST_SA=                           # SA VIIKEY登录IP白名单

# --- 启用SSL前先能力探测（经验1149526：工具链缺失时退回127.0.0.1绑定+IP白名单）
SSL_ENABLED=0                              # 0=禁用 SSL；1=启用时必须存在cert/key否则启动失败
SSL_CERT_PATH=__CHANGE_ME__
SSL_KEY_PATH=__CHANGE_ME__
BIND_HOST=127.0.0.1                        # ⚠️ 生产前先放127.0.0.1 + nginx反代；0.0.0.0需SA VIIKEY审批
BIND_PORT=5000

# --- 规则治理 & 弱约束词扫描（§14 L0铁律）
RULE_ENFORCER_INTERVAL_SEC=300
RULE_WEAK_WORDS_TARGET=0                   # 目标=0，任何>0触发告警+auto_rule_strengthener修复
RULE_GOVERNANCE_7STEP_REQUIRED=1           # 规则修改7步审批 未通过=pre-commit拦截

# --- AI脑库投喂 & EigenFlux 5人磋商（安全告警链路）
SEC_ALERT_BRAIN_FEED=1
SEC_ALERT_EIGENFLUX_PANEL=1
SEC_ALERT_NOTIFY_SA=1

# 性能配置
ENABLE_PROFILING=false
SLOW_QUERY_THRESHOLD=1000
MEMORY_THRESHOLD=0.8

# 备份配置
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups